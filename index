                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Gallery -->
    <section id="gallery" style="background: rgba(255,255,255,0.01);">
        <div class="container">
            <div class="section-header">
                <p class="section-subtitle">Portfolio</p>
