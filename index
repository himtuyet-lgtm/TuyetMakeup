        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-light: #fff5f7;
            --bg-card: #ffffff;
            --bg-card-hover: #fff0f4;
            --pink-primary: #d87093;
            --pink-accent: #e0829d;
            --pink-deep: #b84a6e;
            --pink-soft: #fbebee;
            --text-dark: #332228;
            --text-sub: #664450;
            --border-pink: #f2c2ce;
            --border-strong: #d87093;
            --font-head: 'Cormorant Garamond', serif;
            --font-body: 'Montserrat', sans-serif;
        }

        body {
            background-color: var(--bg-light) !important;
            color: var(--text-dark) !important;
            font-family: var(--font-body);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* HEADER & NAVIGATION */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(255, 245, 247, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-pink);
        }

        .nav-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
        }

        .logo {
            font-family: var(--font-head);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--pink-deep);
            letter-spacing: 2px;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-menu a {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

        .nav-menu a:hover {
            color: var(--pink-primary);
        }

        /* HERO SECTION */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: linear-gradient(rgba(255, 245, 247, 0.82), rgba(255, 240, 244, 0.92)),
                        url('https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=1600') center/cover no-repeat;
            padding-top: 120px;
            padding-bottom: 60px;
        }

        .hero-sub {
            color: var(--pink-deep);
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .hero-title {
            font-family: var(--font-head);
            font-size: 3.8rem;
            color: var(--pink-deep);
            line-height: 1.15;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .contact-details {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .contact-link {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--pink-deep);
            letter-spacing: 1.5px;
            padding: 10px 24px;
            border: 1px solid var(--border-pink);
            border-radius: 30px;
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(216, 112, 147, 0.12);
            transition: all 0.3s ease;
        }

        .contact-link:hover {
            background: var(--pink-primary);
            color: #ffffff;
            border-color: var(--pink-primary);
            transform: translateY(-2px);
        }

        /* QR CODE DISPLAY */
        .qr-wrapper {
            margin-top: 10px;
            background: #ffffff;
            padding: 18px;
            border-radius: 20px;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 10px 25px rgba(216, 112, 147, 0.15);
            border: 1px solid var(--border-pink);
        }

        .qr-card-title {
            color: var(--pink-deep);
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .qr-card-stk {
            color: var(--text-dark);
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .qr-img {
            width: 220px;
            height: auto;
            border-radius: 12px;
            display: block;
        }

        .hero-desc {
            font-size: 1.05rem;
            color: var(--text-sub);
            max-width: 700px;
            margin: 30px auto 0 auto;
        }

        /* SECTION STYLES */
        section {
            padding: 90px 0;
        }

        .sec-title-box {
            text-align: center;
            margin-bottom: 50px;
        }

        .sec-subtitle {
            color: var(--pink-deep);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .sec-title {
            font-family: var(--font-head);
            font-size: 2.8rem;
            color: var(--pink-deep);
        }

        /* PORTFOLIO GALLERY */
        .filter-bar {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 35px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: #ffffff;
            border: 1px solid var(--border-pink);
            color: var(--text-dark);
            padding: 8px 24px;
            border-radius: 25px;
            cursor: pointer;
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: 0 2px 8px rgba(216, 112, 147, 0.08);
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--pink-primary);
            color: #ffffff;
            border-color: var(--pink-primary);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .gallery-card {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 3/4;
            cursor: pointer;
            border: 1px solid var(--border-pink);
            box-shadow: 0 6px 20px rgba(216, 112, 147, 0.1);
        }

        .gallery-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .gallery-card:hover img {
            transform: scale(1.08);
        }

        .gallery-info {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(184, 74, 110, 0.9) 0%, transparent 70%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .gallery-card:hover .gallery-info {
            opacity: 1;
        }

        .gallery-cat {
            color: #ffe6ee;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .gallery-name {
            font-family: var(--font-head);
            font-size: 1.4rem;
            color: #ffffff;
        }

        /* SERVICES & PRICING */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
        }

        .service-box {
            background: var(--bg-card);
            border: 1px solid var(--border-pink);
            padding: 35px 25px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(216, 112, 147, 0.08);
            transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .service-box:hover {
            transform: translateY(-8px);
            background: var(--bg-card-hover);
            border-color: var(--pink-primary);
            box-shadow: 0 12px 30px rgba(216, 112, 147, 0.18);
        }

        .service-box.featured {
            border: 2px solid var(--pink-primary);
            background: #fffafa;
        }

        .service-icon {
            font-size: 2.3rem;
            color: var(--pink-primary);
            margin-bottom: 18px;
        }

        .service-price {
            font-family: var(--font-head);
            font-size: 2rem;
            color: var(--pink-deep);
            margin: 15px 0;
            font-weight: 700;
        }

        .service-list {
            list-style: none;
            margin: 20px 0 0 0;
            color: var(--text-sub);
            font-size: 0.9rem;
        }

        .service-list li {
            margin-bottom: 10px;
            border-bottom: 1px dashed var(--border-pink);
            padding-bottom: 8px;
            color: var(--text-dark);
        }

        /* ABOUT SECTION */
        .about-flex {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-img {
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-pink);
            box-shadow: 0 10px 30px rgba(216, 112, 147, 0.12);
        }

        .about-img img {
            width: 100%;
            display: block;
            object-fit: cover;
        }

        .about-text h3 {
            font-family: var(--font-head);
            font-size: 2.4rem;
            color: var(--pink-deep);
            margin-bottom: 15px;
        }

        .about-text p {
            color: var(--text-sub);
            margin-bottom: 20px;
            font-size: 1rem;
            line-height: 1.7;
        }

        /* FOOTER */
        footer {
            border-top: 1px solid var(--border-pink);
            padding: 40px 0;
            text-align: center;
            background: #fce8ed;
            color: var(--text-dark);
            font-size: 0.9rem;
        }

        .footer-info {
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .footer-info a {
            color: var(--pink-deep);
            font-weight: 600;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s;
        }

        .footer-info a:hover {
            color: var(--pink-primary);
        }

        .socials {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .socials a {
            color: var(--pink-deep);
            font-size: 1.4rem;
            transition: color 0.3s;
        }

        .socials a:hover {
            color: var(--pink-primary);
        }

        /* LIGHTBOX MODAL */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: rgba(51, 34, 40, 0.88);
            backdrop-filter: blur(8px);
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-img {
            max-width: 90%;
            max-height: 85vh;
            border-radius: 12px;
            border: 2px solid var(--border-pink);
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        }

        .modal-close {
            position: absolute;
            top: 25px;
            right: 35px;
            color: #ffffff;
            font-size: 2.5rem;
            cursor: pointer;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .hero-title { font-size: 2.5rem; }
            .nav-menu { display: none; }
            .about-flex { grid-template-columns: 1fr; }
        }
    </style>
</head>
